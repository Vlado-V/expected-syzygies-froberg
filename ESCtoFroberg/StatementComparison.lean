module

public import ESCtoFroberg.IndependentStatement
public import ESCtoFroberg.Statement

@[expose] public section

noncomputable section
namespace ESCtoFroberg.StatementComparison
open MvPolynomial Module

variable (K : Type*) [Field K]

/-- Taking the ideal generated by a vector-space span does not add generators
to the ideal beyond the original set. -/
theorem ideal_span_vector_span {n : ℕ} (s : Set (MvPolynomial (Fin n) K)) :
    Ideal.span (Submodule.span K s : Set (MvPolynomial (Fin n) K)) = Ideal.span s := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    have h : Submodule.span K s ≤ (Ideal.span s).restrictScalars K :=
      Submodule.span_le.mpr Ideal.subset_span
    exact h
  · exact Ideal.span_mono Submodule.subset_span

theorem degreeBasis_eq (n d : ℕ) :
    Independent.degreeBasis K n d = Froberg.formsBasis K n d := rfl

theorem generator_eq (n d r : ℕ) (a : Independent.Coefficients n d r → K) (i : Fin r) :
    Independent.generator K n d r a i = Froberg.coefficientForms K n d r a i := rfl

theorem generatorIdeal_eq (n d r : ℕ) (a : Independent.Coefficients n d r → K) :
    Independent.generatorIdeal K n d r a =
      Ideal.span (Froberg.coefficientSpace K n d r a : Set (Froberg.Poly K n)) := by
  symm
  exact ideal_span_vector_span K _

theorem generatorHilbertFunction_eq (n d r t : ℕ)
    (a : Independent.Coefficients n d r → K) :
    Independent.quotientHilbertFunction K (Independent.generatorIdeal K n d r a) t =
      Froberg.hilbertFunction (Froberg.coefficientSpace K n d r a) t := by
  rw [generatorIdeal_eq]
  rfl

theorem positiveTruncation_eq (n d r t : ℕ) :
    Independent.positivelyTruncated n d r t = Froberg.predictedHilbertFunction n d r t := by
  classical
  simp [Independent.positivelyTruncated, Independent.rawCoefficient, Independent.rawSeries,
    Froberg.predictedHilbertFunction, Froberg.positiveTruncation,
    Froberg.predictionCoefficient, Froberg.predictionSeries,
    Finset.mem_range]
  rfl

theorem pointChop_eq {m p : ℕ} (a : Independent.PointParameters K m p) (d : ℕ) :
    Independent.pointChop K a d = choppedIdeal K a d := by
  unfold Independent.pointChop choppedIdeal
  congr 1
  ext f
  exact (mem_pointDegreeSpace a f).symm

theorem pointChopHilbertFunction_eq {m p : ℕ}
    (a : Independent.PointParameters K m p) (d t : ℕ) :
    Independent.quotientHilbertFunction K (Independent.pointChop K a d) t =
      choppedHilbertFunction K a d t := by
  rw [pointChop_eq]
  rfl

theorem beforePlateau_iff (n p d e : ℕ) :
    Independent.beforePlateau n p d e ↔ ¬PlateauReached n d p e := by
  constructor
  · intro h
    rintro ⟨i, hi, hie, hc⟩
    exact (not_le.mpr (h i hie hi)) hc
  · intro h i hie hi
    exact lt_of_not_ge (fun hc => h ⟨i, hi, hie, hc⟩)

theorem expectedChopDimension_eq (n p d e : ℕ) :
    Independent.expectedChopDimension n p d e = choppedPrediction n d p e := by
  classical
  unfold Independent.expectedChopDimension choppedPrediction
  rw [beforePlateau_iff]
  by_cases h : PlateauReached n d p e <;> simp [h]
  rfl

theorem expectedSyzygies_iff :
    Independent.ExpectedSyzygies K ↔ ExpectedSyzygyConjecture K := by
  unfold Independent.ExpectedSyzygies ExpectedSyzygyConjecture GenericPointProperty
  simp only [Independent.leastInterpolationDegree, Independent.monomialCount,
    IsInterpolationDegree, N, Independent.distinct, DistinctPoints,
    pointChopHilbertFunction_eq, expectedChopDimension_eq]

theorem generalFormsThrough2d_iff :
    Independent.GeneralFormsThrough2d K ↔ FrobergThrough2d K := by
  unfold Independent.GeneralFormsThrough2d FrobergThrough2d Froberg.GenericHilbertThrough
  simp only [generatorHilbertFunction_eq, positiveTruncation_eq]

/-- The independently formulated actual-ring implication is exactly the
statement used by the proof project. This establishes the target identity only;
it does not assume or claim the mathematical implication itself. -/
theorem theorem11_iff_paperStatement : Independent.Theorem11 ↔ PaperStatement := by
  unfold Independent.Theorem11 PaperStatement
  simp only [expectedSyzygies_iff, generalFormsThrough2d_iff]

end ESCtoFroberg.StatementComparison
